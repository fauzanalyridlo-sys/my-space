generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  passwordHash    String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  checkIns        DailyCheckIn[]
  reflections     DailyReflection[]
  notes           Note[]
  aiConversations AiConversation[]
  aiMemories      AiMemory[]
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyReflection {
  id              Int      @id @default(autoincrement())
  date            DateTime
  howWasYourDay   String
  whatDidYouLearn String
  tomorrow        String
  letGo           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyCheckIn {
  id         Int      @id @default(autoincrement())
  date       DateTime
  mood       Int
  energy     Int
  sleepHours Float?
  activities String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model AiConversation {
  id        Int      @id @default(autoincrement())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}

model AiMessage {
  id             Int      @id @default(autoincrement())
  role           String
  content        String
  createdAt      DateTime @default(now())
  conversationId Int

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AiMemory {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
